# ============================================================
# AROMA HAVEN CAFÉ — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.
# ============================================================

# --- Supabase ---
# Create a project at https://supabase.com and find these in Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Admin Setup ---
# Used only for initial admin account creation via seed script
ADMIN_EMAIL=admin@aromahavencafe.com
ADMIN_PASSWORD=change_this_to_a_secure_password

# --- Google OAuth (Future) ---
# Configure in Supabase Dashboard > Auth > Providers > Google
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Razorpay (Future — Sandbox) ---
# RAZORPAY_KEY_ID=your_razorpay_test_key
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# --- Resend Email (Future) ---
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=orders@aromahavencafe.com

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aroma Haven Café

# --- Session & Security ---
# Session expiration in seconds (default: 7 days)
SESSION_EXPIRY=604800
